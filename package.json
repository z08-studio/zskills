{
  "name": "zskills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local workbench for reading and exploring Agent Skills",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/z08-studio/zskills.git"
  },
  "homepage": "https://github.com/z08-studio/zskills#readme",
  "bugs": {
    "url": "https://github.com/z08-studio/zskills/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && node scripts/rust.mjs check --locked",
    "build": "npm run typecheck && vite build && node scripts/rust.mjs build --release --locked",
    "start": "node scripts/start.mjs",
    "test": "tsx --test src/*.test.ts && node scripts/rust.mjs test --locked",
    "format": "prettier --write . && node scripts/rust.mjs fmt --all",
    "format:check": "prettier --check . && node scripts/rust.mjs fmt --all -- --check",
    "lint:rust": "node scripts/rust.mjs clippy --all-targets --locked -- -D warnings"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
